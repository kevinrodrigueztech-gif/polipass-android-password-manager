<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_gravity="center">

    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        app:lottie_imageAssetsFolder="assets"
        app:lottie_fileName="editar.json"
        android:layout_margin="30dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"/>

    <Button
        android:id="@+id/Btn_Editar_Registro"
        android:text="@string/Btn_Editar_Registro"
        android:background="@color/colorPrimary"
        android:textSize="30sp"
        android:textColor="#ffffff"
        android:fontFamily="@font/dosis_bold"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        app:lottie_imageAssetsFolder="assets"
        app:lottie_fileName="borrar.json"
        android:layout_margin="30dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"/>

    <Button
        android:id="@+id/Btn_Eliminar_Registro"
        android:text="@string/Btn_Eliminar_Registro"
        android:background="@color/colorPrimary"
        android:textColor="#ffffff"
        android:layout_marginTop="15dp"
        android:fontFamily="@font/dosis_bold"
        android:layout_width="match_parent"
        android:textSize="30sp"
        android:layout_height="match_parent"/>

</androidx.appcompat.widget.LinearLayoutCompat>